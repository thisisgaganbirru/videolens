{
  "name": "videolens-frontend",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build && node scripts/inject-csp.mjs && node scripts/build-sw.mjs",
    "build:mobile": "cross-env CAPACITOR_BUILD=true next build && node scripts/fix-export-segments.mjs && node scripts/inject-csp.mjs --export && node scripts/build-sw.mjs --export",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@next/env": "^16.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "minimatch@^10": "11.0.5",
    "postcss-selector-parser": "6.1.5",
    "rimraf": "6.1.4",
    "zod": "4.6.7"
  }
}
