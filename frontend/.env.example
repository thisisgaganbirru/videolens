NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: the Clerk publishable key. Leave blank and the app has no sign-in
# at all - every request is anonymous, scoped by X-Client-ID as before.
# Pair it with AUTH_JWKS_URL / AUTH_ISSUER on the backend (see DEPLOYMENT.md).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
