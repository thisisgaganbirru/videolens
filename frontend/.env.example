NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional sign-in (auth phase 2, docs/frontend/auth-sign-in.md). The
# Supabase project URL and its publishable key (sb_publishable_..., safe to
# ship in the bundle). Leave either blank to disable sign-in: no Account tab,
# no provider code loaded, every request anonymous as before. Both are
# inlined at build time and the URL's origin is added to the CSP connect-src.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
