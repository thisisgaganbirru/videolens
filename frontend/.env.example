NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Deployed web app origin. Only consumed by the native Android build, which
# fetches <origin>/version.json to detect newer builds (infrastructure/
# updateCheck.ts). Unset is fine for web and local dev - the update check is
# native-Android-only and no-ops without it.
NEXT_PUBLIC_WEB_BASE_URL=
