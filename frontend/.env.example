NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The web app's own public origin: canonical links, the social preview image,
# sitemap.xml and robots.txt are built from it. Defaults to the production
# domain when unset (infrastructure/siteOrigin.ts). Set it when the site moves
# to a custom domain.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Set to 1 on a deployment that must never be indexed (dev): robots.txt
# becomes Disallow: /, every page gets a noindex meta and an X-Robots-Tag
# header. Leave unset in production.
# NEXT_PUBLIC_NOINDEX=1
