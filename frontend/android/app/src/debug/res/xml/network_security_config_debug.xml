<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (see src/debug/AndroidManifest.xml). Cleartext stays off
     everywhere except the loopback names a local backend is reached by:
     localhost / 127.0.0.1 (adb reverse) and 10.0.2.2 (the emulator's alias
     for the host). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
