<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-transfer rules. Older releases read
  backup_rules.xml (android:fullBackupContent) instead; keep the two in step.

  The WebView's localStorage holds the bring-your-own Gemini key
  (videolens-gemini-api-key, infrastructure/apiKeyStore.ts), so its directory
  never leaves the device: not in a cloud backup, not in a phone-to-phone
  transfer. Everything else keeps the default (back up all app data), which
  is what carries the run History (IndexedDB, app_webview/Default/IndexedDB/)
  to a new phone. Path verified on an API 36 emulator: the Chromium WebView
  profile lives at <app data>/app_webview/Default/. See
  docs/frontend/security-headers.md.

  Side effect: the rest of localStorage (theme choice, the Welcome flag, the
  free-run device token, the client id) is not restored either. A restored
  install starts those fresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
