# node
node_modules/
.next/
out/
*.tsbuildinfo
dist/

# Generated by frontend/scripts/build-sw.mjs from frontend/sw/sw.template.js
# after every build. It carries the build's content-hashed chunk filenames, so
# it cannot be checked in — edit the template, never this.
frontend/public/sw.js

# python
__pycache__/
*.pyc
.venv/
venv/

# env
.env
*.env.local

# misc
.DS_Store
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/

# IDE / local tool state
.idea/
.hallmark/

# naming/branding research (not for the repo)
research/

# per-task session logs (local scratch, not for the repo)
mem/

# Android signing secrets
*.jks
*.keystore
# Debug keystore is intentionally checked in (not a secret): a stable debug
# signing identity lets a newly installed APK be treated as an update to the
# previous one instead of Android refusing the install over a mismatched key.
!frontend/android/debug.keystore
keystore.properties
