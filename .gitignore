# node
node_modules/
.next/
out/
*.tsbuildinfo
dist/

# Generated by frontend/scripts/build-sw.mjs from frontend/sw/sw.template.js
# after every build. It carries the build's content-hashed chunk filenames, so
# it cannot be checked in — edit the template, never this.
frontend/public/sw.js

# python
__pycache__/
*.pyc
.venv/
venv/
# local identity database (DATABASE_URL=sqlite+aiosqlite:///...)
*.sqlite3

# env: every local variant (.env, .env.local, .env.production, .env.dev, ...);
# only the .env.example templates are tracked
.env
.env.*
*.env.local
!.env.example

# local credentials kept beside the code
DATABASE_URL.txt
*.pw

# The MCP server is parked on the unmerged branch feature/mcp-server on
# purpose (CLAUDE.md); a local copy left over from that branch stays out of
# this one. If this file is ever merged into feature/mcp-server, its tracked
# files stay tracked (ignoring never untracks), but a new file under mcp/
# there would need `git add -f` or a `!mcp/` line on that branch.
mcp/

# misc
.DS_Store
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/

# IDE / local tool state
.idea/
.hallmark/

# naming/branding research (not for the repo)
research/

# per-task session logs (local scratch, not for the repo)
mem/

# Android signing secrets
*.jks
*.keystore
# Debug keystore is intentionally checked in (not a secret): a stable debug
# signing identity lets a newly installed APK be treated as an update to the
# previous one instead of Android refusing the install over a mismatched key.
!frontend/android/debug.keystore
keystore.properties

# Owner design handoff (boards, screenshots, tokens): local only, kept out of dev
design/

# Scratch channel between AI tools; not project content
relay.md

# Security assessments list open findings: local only, never committed
*Security-Assessment*.xlsx
*security-assessment*.xlsx
