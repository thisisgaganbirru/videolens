GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional: configure one cookie source for login-gated media URLs.
# Local development example: chrome, edge, firefox, brave, or opera.
YTDLP_COOKIES_FROM_BROWSER=
# Deployment example: path to a mounted Netscape-format cookies.txt secret.
YTDLP_COOKIES_FILE=
FFMPEG_LOCATION=
MAX_FILE_SIZE_MB=200
MAX_DURATION_SECONDS=180
RATE_LIMIT_PER_HOUR=20
# Total accepted runs per UTC day across ALL callers, regardless of IP - the
# backstop against total Gemini spend once RATE_LIMIT_PER_HOUR alone isn't
# enough (traffic spread across many IPs). Tune to what you're willing to
# spend per day at your Gemini model's price. 0 disables the cap.
DAILY_RUN_CAP=200
# How long a completed run's transcript/summary/markdown - and its entry in
# a caller's history list - stays in Redis. 604800 = 7 days. Bump to 2592000
# for 30 days if you want longer history. This is a real retention change,
# not just a cache TTL: it means analysis results persist for this long
# instead of being deleted right after the run completes.
RUN_TTL_SECONDS=604800
WORKER_MAX_JOBS=2
WORKER_JOB_TIMEOUT_SECONDS=600
TEMP_DIR=/tmp/videolens
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005
REDIS_URL=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Sign-in. Leave all three blank and the app is anonymous-only, exactly as
# before accounts existed. With Clerk: JWKS URL is
# https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json and
# the issuer is https://<your-frontend-api>.clerk.accounts.dev (both shown on
# the Clerk dashboard under API keys). AUTH_AUDIENCE is optional - Clerk's
# default session token carries no `aud` claim; set it only if you add one
# via a JWT template, and then it is enforced.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
ALLOW_ANONYMOUS=true

# Durable storage for accounts, workspaces, usage and the searchable library.
# Blank = none of the paid features exist and everything is Redis/in-memory as
# before. postgres:// and postgresql:// are both accepted. Migrations run at
# API and worker startup when DB_AUTO_MIGRATE is true; set it to false when
# you would rather run `alembic upgrade head` yourself.
DATABASE_URL=
DB_AUTO_MIGRATE=true

# Billing. Blank secret key = plans are shown but cannot be bought (503 on the
# billing routes, no upgrade buttons). Three recurring prices, one metered
# overage price on a Meter whose event name is STRIPE_METER_EVENT_NAME, and a
# webhook endpoint at /api/webhooks/stripe - see DEPLOYMENT.md "Paid tier".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_OVERAGE=
STRIPE_METER_EVENT_NAME=videolens_minutes
# Where Stripe Checkout and the billing portal send people back to. Defaults
# to the first ALLOWED_ORIGINS entry, which is the deployed frontend.
FRONTEND_BASE_URL=

# Read access to this repository's releases, used by GET /api/releases to
# serve the in-app Releases tab and the Android update check. The repo is
# private, so a browser cannot ask GitHub directly and a token cannot ship
# in client-side JS - this is what lets the read happen server-side instead
# of CI committing a static manifest into the repo. A fine-grained token
# with read-only Contents access is enough. Leave blank and the endpoint is
# inert: the Releases tab is empty and update checks no-op.
GITHUB_TOKEN=
GITHUB_REPO=thisisgaganbirru/videolens
