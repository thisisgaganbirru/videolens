GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Optional second model tried (same uploaded file, 2 attempts) once GEMINI_MODEL keeps returning 429/5xx. Blank = no fallback.
GEMINI_FALLBACK_MODEL=
# Attempts on GEMINI_MODEL for transient 429/5xx, with full-jitter exponential
# backoff (2s base, doubling) whose per-retry ceiling is capped at the max delay.
GEMINI_RETRY_ATTEMPTS=6
GEMINI_RETRY_MAX_DELAY_SECONDS=20

# Optional: configure one cookie source for login-gated media URLs.
# Local development example: chrome, edge, firefox, brave, or opera.
YTDLP_COOKIES_FROM_BROWSER=
# Deployment example: path to a mounted Netscape-format cookies.txt secret.
YTDLP_COOKIES_FILE=
# Tallest video fetched for URL runs (soft cap: if a source has nothing this
# small, its smallest variant is used). 0 or less = no cap.
YTDLP_MAX_HEIGHT=720
FFMPEG_LOCATION=
MAX_FILE_SIZE_MB=200
MAX_DURATION_SECONDS=180
# The bigger set for a caller who is signed in AND sends their own Gemini key
# (X-Gemini-Api-Key). Everyone else gets the two above. A value at or below
# the standard one means the standard one (never lower). GET /api/limits
# reports both sets to the client.
SIGNED_IN_BYOK_MAX_DURATION_SECONDS=600
SIGNED_IN_BYOK_MAX_FILE_SIZE_MB=500
RATE_LIMIT_PER_HOUR=20
# Per-IP limit on the read endpoints (GET /api/runs/{id} polling, GET /api/runs,
# GET /api/free-runs). They spend no Gemini budget but each is a Redis round
# trip, and free-runs mints a device token for any caller. The web app polls
# one run every 3 s. <= 0 disables.
READ_RATE_LIMIT_PER_MINUTE=120
# How many trailing X-Forwarded-For entries the deployment's own proxies write.
# The client IP (rate limit, free-run IP backstop) is the entry that many from
# the END of the header; anything further left was written by the client and is
# ignored. 2 for Railway: its edge rewrites the header to "<client>, <edge hop>"
# and the edge hop changes per request (measured 2026-11-07). 1 for a proxy
# that appends only the client. 0 = ignore the header and use the socket peer.
# With no header (local, docker compose) the peer is used whatever this is.
# Verify by logging a request sent with a forged X-Forwarded-For.
TRUSTED_PROXY_HOPS=2
# Total accepted runs per UTC day across ALL callers, regardless of IP - the
# backstop against total Gemini spend once RATE_LIMIT_PER_HOUR alone isn't
# enough (traffic spread across many IPs). Tune to what you're willing to
# spend per day at your Gemini model's price. 0 disables the cap.
DAILY_RUN_CAP=200
# Free runs per device per UTC day for callers WITHOUT their own Gemini key
# (anonymous web/PWA users). Counted against a signed device token from
# GET /api/free-runs. <= 0 turns the allowance off (no token needed).
FREE_RUNS_PER_DEVICE=3
# Backstop per client IP per UTC day, since clearing browser storage mints a
# new device but not a new IP. Higher than the device limit because offices,
# campuses and mobile carriers put many people behind one IP. <= 0 disables
# only this backstop.
FREE_RUNS_PER_IP=10
# Free runs per signed-in account per UTC day (callers without their own
# key). Replaces the device count for that caller, not added to it, and
# follows the account across devices. Stored with the identity tables
# (migrations 0003 and 0005; in memory without DATABASE_URL in local mode).
# <= 0 turns it off: signed-in callers fall back to FREE_RUNS_PER_DEVICE.
# Replaces FREE_RUNS_PER_ACCOUNT_MONTHLY (2026-11-14), which is ignored.
FREE_RUNS_PER_ACCOUNT_DAILY=10
# HMAC key that signs device tokens. REQUIRED when REDIS_URL is set and
# FREE_RUNS_PER_DEVICE > 0 (the API refuses to start otherwise: replicas must
# share it). Blank in local mode = random per process, with a warning.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it re-issues every device a token (today's counts are kept per
# device id, so a rotation effectively resets anonymous devices' counts).
DEVICE_TOKEN_SECRET=
# How long a run (its transcript/summary/markdown and its entry in the
# caller's GET /api/runs list) stays on the server. The browser keeps History
# in IndexedDB now; the server only holds a run until it has been delivered.
# 3600 = 1 hour, re-armed on every write so it counts from completion. This
# also bounds what the MCP server's list_recent_runs can see (last hour only).
RUN_TTL_SECONDS=3600
WORKER_MAX_JOBS=2
WORKER_JOB_TIMEOUT_SECONDS=600
# arq timeout for runs admitted under the signed-in + BYOK limits (their own
# job function, process_long_run). Never below WORKER_JOB_TIMEOUT_SECONDS.
# Also sets how long a stuck long run takes to be reported as abandoned
# (this + 120 s) and how long its one-per-account long-run slot lives.
WORKER_LONG_JOB_TIMEOUT_SECONDS=1800
TEMP_DIR=/tmp/videolens
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005
REDIS_URL=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# auto (path-style with a custom endpoint, fine for MinIO), path, or virtual.
# Railway Buckets: use the style the bucket's Credentials tab names.
S3_ADDRESSING_STYLE=auto
# Sign-in: OIDC token verification. Blank = anonymous only (the default);
# sign-in is opt-in and anonymous use keeps working either way. With
# Supabase Auth (one project per Railway environment) the values are:
#   AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
#   AUTH_AUDIENCE=authenticated
# The project's signing key must be asymmetric (ES256 or RS256; Supabase:
# Authentication > JWT Keys). HS256 is refused by design. The audience is
# enforced whenever it is set.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
ALLOW_ANONYMOUS=true
# Accounts, workspaces and API keys. Blank = kept in process memory locally
# (gone on restart), and no account store at all in distributed mode.
# Supabase: the Supavisor transaction pooler (port 6543) as the
# least-privilege backend role, never the postgres superuser:
#   DATABASE_URL=postgresql://videolens_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local file instead: DATABASE_URL=sqlite+aiosqlite:///./videolens-dev.sqlite3
# Either way the schema is created by `alembic upgrade head` (run from backend/).
DATABASE_URL=
# Live API keys a workspace may hold at once.
API_KEYS_PER_WORKSPACE=10

# --- Paid plan (Stripe, docs/backend/billing.md) --------------------------
# Blank STRIPE_SECRET_KEY (or any other required STRIPE_* value) = billing
# off: every account is on the free rules and the `billing` capability row
# reads "disabled". TEST MODE keys only until the owner says otherwise.
# Never commit a key: set them in the platform's variables (or your local,
# gitignored .env). Required: SECRET_KEY, WEBHOOK_SECRET, PRICE_MONTHLY,
# PRICE_EXTRA_RUN (and METER_EVENT_NAME, which has a default).
STRIPE_SECRET_KEY=
# whsec_... from the webhook endpoint, or from `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...). Amounts live in Stripe and are read back for display.
STRIPE_PRICE_MONTHLY=
# Optional: blank = no yearly plan (checkout refuses interval=year).
STRIPE_PRICE_YEARLY=
# Monthly usage-based price on the extra-run meter.
STRIPE_PRICE_EXTRA_RUN=
# Optional: a yearly usage-based price on the same meter, used for yearly
# plans instead (only if Checkout refuses mixed intervals).
STRIPE_PRICE_EXTRA_RUN_YEARLY=
STRIPE_METER_EVENT_NAME=videolens_extra_run
# Where Checkout and the Customer Portal return (/app?view=account&billing=...).
# Blank = the first non-* ALLOWED_ORIGINS entry, else http://localhost:3005.
BILLING_RETURN_ORIGIN=
# Included shared-key runs per UTC day on the paid plan (the same daily account
# row free runs use, its own limit). Past it, runs are billed per run on
# completion. Replaces PAID_RUNS_PER_MONTH (2026-11-14), which is ignored.
PAID_RUNS_PER_DAY=30
# Safety cap on extra runs per account per UTC month (402 extra_runs_cap).
# 0 = no cap.
PAID_EXTRA_RUNS_MONTHLY_CAP=200
# Paid media limits without a key. <= 0 = the SIGNED_IN_BYOK_* values.
PAID_MAX_DURATION_SECONDS=0
PAID_MAX_FILE_SIZE_MB=0
# Saved history (docs/backend/saved-history.md): paid accounts' results are
# saved on the server (needs DATABASE_URL and billing). Once the paid plan
# ends, saved runs stay this many days, then the worker removes them.
PAID_SAVED_RUNS_GRACE_DAYS=30
# Largest saved result in bytes of JSON (segments are dropped first, then
# the run is not saved, logged). Normal runs are far below it.
PAID_SAVED_RUN_MAX_BYTES=2097152
# DELETE /api/me is a hold of this many days: the account stops working at
# once and can be restored by signing in; after it the worker removes the
# account, its saved runs and its Supabase user for good. Free accounts too.
ACCOUNT_DELETION_HOLD_DAYS=30

# Read access to this repository's releases, used by GET /api/releases to
# serve the in-app Releases tab and the Android update check. The repo is
# private, so a browser cannot ask GitHub directly and a token cannot ship
# in client-side JS - this is what lets the read happen server-side instead
# of CI committing a static manifest into the repo. A fine-grained token
# with read-only Contents access is enough. Leave blank and the endpoint is
# inert: the Releases tab is empty and update checks no-op.
GITHUB_TOKEN=
GITHUB_REPO=thisisgaganbirru/videolens
